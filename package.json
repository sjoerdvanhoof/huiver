{
  "name": "huiver-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "start": "bun run --cwd apps/web start",
    "build": "bun run --cwd apps/web build",
    "test": "bun run --cwd packages/shared test && bun run --cwd apps/web test",
    "e2e": "bun run --cwd apps/web e2e",
    "e2e:resume": "bun run --cwd apps/web e2e:resume",
    "examples": "bun run --cwd apps/web examples",
    "examples:import": "bun run --cwd apps/web examples:import",
    "voices": "bun run --cwd apps/web voices",
    "setup:python": "bun run --cwd apps/web setup:python",
    "setup:chatterbox": "bun run --cwd apps/web setup:chatterbox",
    "typecheck": "bunx tsc --noEmit -p apps/web && bunx tsc --noEmit -p packages/shared",
    "ios:setup": "apps/web/.venv-chatterbox/bin/pip install -q coremltools",
    "ios:export": "cd tools/export && ../../apps/web/.venv-chatterbox/bin/python export_models.py --out ../../apps/ios/build",
    "ios:voices": "cd tools/export && ../../apps/web/.venv-chatterbox/bin/python export_voices.py --out ../../apps/ios/build-voices",
    "ios:verify": "cd tools/export && ../../apps/web/.venv-chatterbox/bin/python verify_parity.py --models ../../apps/ios/build",
    "ios:install": "apps/ios/scripts/install-models.sh",
    "kit:test": "cd packages/huiverkit && swift test",
    "ios:build": "xcodebuild -project apps/ios/Huiver.xcodeproj -scheme Huiver -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -configuration Debug build CODE_SIGNING_ALLOWED=NO",
    "ios:device": "apps/ios/scripts/run-device.sh",
    "ios:previews": "cd tools/export && ../../apps/web/.venv-chatterbox/bin/python export_previews.py --out ../../apps/ios/build-voices"
  }
}
