{
  "name": "huiver-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "start": "bun run --cwd apps/web start",
    "build": "bun run --cwd apps/web build",
    "test": "bun run --cwd packages/shared test && bun run --cwd apps/web test",
    "e2e": "bun run --cwd apps/web e2e",
    "e2e:resume": "bun run --cwd apps/web e2e:resume",
    "examples": "bun run --cwd apps/web examples",
    "examples:import": "bun run --cwd apps/web examples:import",
    "voices": "bun run --cwd apps/web voices",
    "setup:python": "bun run --cwd apps/web setup:python",
    "setup:chatterbox": "python3.11 -m venv tools/export/.venv-chatterbox && tools/export/.venv-chatterbox/bin/pip install -q --upgrade pip && tools/export/.venv-chatterbox/bin/pip install -q -r tools/export/requirements.txt && tools/export/.venv-chatterbox/bin/pip install -q --force-reinstall --no-deps -r tools/export/requirements.txt",
    "typecheck": "bunx tsc --noEmit -p apps/web && bunx tsc --noEmit -p packages/shared",
    "ios:setup": "tools/export/.venv-chatterbox/bin/pip install -q coremltools",
    "ios:export": "cd tools/export && ./.venv-chatterbox/bin/python export_models.py --out ../../apps/ios/build",
    "ios:voices": "cd tools/export && ./.venv-chatterbox/bin/python export_voices.py --out ../../apps/ios/build-voices",
    "ios:verify": "cd tools/export && ./.venv-chatterbox/bin/python verify_parity.py --models ../../apps/ios/build",
    "ios:install": "apps/ios/scripts/install-models.sh",
    "kit:test": "cd packages/huiverkit && swift test",
    "ios:build": "xcodebuild -project apps/ios/Huiver.xcodeproj -scheme Huiver -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -configuration Debug build CODE_SIGNING_ALLOWED=NO",
    "ios:device": "apps/ios/scripts/run-device.sh",
    "ios:previews": "cd tools/export && ./.venv-chatterbox/bin/python export_previews.py --out ../../apps/ios/build-voices",
    "mac:build": "xcodebuild -project apps/mac/Huiver.xcodeproj -scheme Huiver -configuration Debug build -allowProvisioningUpdates -derivedDataPath apps/mac/DerivedData",
    "mac:install": "apps/mac/scripts/install-models.sh",
    "mac:run": "bun run mac:build && open apps/mac/DerivedData/Build/Products/Debug/Huiver.app",
    "mtl:probe": "cd tools/export && ./.venv-chatterbox/bin/python probe_mtl.py",
    "mtl:verify": "cd tools/export && ./.venv-chatterbox/bin/python verify_mtl.py",
    "mtl:export": "cd tools/export && ./.venv-chatterbox/bin/python export_mtl.py --out ../../apps/mac/build",
    "mac:models": "cd tools/export && ./.venv-chatterbox/bin/python export_mtl.py --out ../../apps/mac/build-mtl --gen-tokens 768 --prompt-tokens 250",
    "mac:voices": "cd tools/export && ./.venv-chatterbox/bin/python export_voices.py --multilingual --out ../../apps/mac/build-voices-mtl",
    "mac:verify": "cd tools/export && ./.venv-chatterbox/bin/python verify_mtl.py --models ../../apps/mac/build-mtl",
    "mac:previews": "cd tools/export && ./.venv-chatterbox/bin/python export_previews.py --multilingual --out ../../apps/mac/build-voices-mtl"
  }
}
