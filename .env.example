# Copy to .env to enable the cloud speech engines. Kokoro runs locally and
# needs none of these. Bun loads .env automatically.

# OPENAI_API_KEY=sk-...
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ELEVENLABS_API_KEY=...
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Override the Python used for the local Kokoro worker (defaults to ./.venv/bin/python)
# HUIVER_PYTHON=/usr/local/bin/python3.11

# Block ALL network access from the speech worker. Kokoro then runs purely from
# ~/.cache/huggingface. Set this once the voices you use have been downloaded —
# each voice is fetched on first use, so an uncached voice will fail while set.
# HUIVER_OFFLINE=1

# How long an idle speech worker lives before exiting, in seconds (default 300).
# HUIVER_WORKER_IDLE_EXIT=300

# Torch device for Kokoro: auto (default) | mps | cpu | cuda.
# "auto" prefers Apple Silicon's GPU (MPS), then CUDA, then CPU. Kokoro itself
# only auto-detects CUDA, so without this a Mac would quietly run on CPU.
# HUIVER_DEVICE=auto
