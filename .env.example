# Copy to .env to enable the cloud speech engines. Kokoro runs locally and
# needs none of these. Bun loads .env automatically.

# OPENAI_API_KEY=sk-...
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ELEVENLABS_API_KEY=...
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Override the Python used for the local Kokoro worker (defaults to ./.venv/bin/python)
# HUIVER_PYTHON=/usr/local/bin/python3.11

# Block ALL network access from the speech worker. Kokoro then runs purely from
# ~/.cache/huggingface. Set this once the voices you use have been downloaded —
# each voice is fetched on first use, so an uncached voice will fail while set.
# HUIVER_OFFLINE=1

# How long an idle speech worker lives before exiting, in seconds (default 300).
# HUIVER_WORKER_IDLE_EXIT=300

# Torch device for Kokoro: auto (default) | mps | cpu | cuda.
# "auto" prefers Apple Silicon's GPU (MPS), then CUDA, then CPU. Kokoro itself
# only auto-detects CUDA, so without this a Mac would quietly run on CPU.
# HUIVER_DEVICE=auto

# Release Metal's completed inference allocations after every generated segment
# so long conversions stay within a bounded amount of memory. Enabled by default;
# set to 0 to favor maximum MPS throughput over memory use.
# HUIVER_MPS_CACHE_CLEAR=1

# Chunks rendered between conversion checkpoints (default 8). A crash or restart
# resumes the chapter from its last checkpoint, so this is roughly the most work
# an interruption can cost. Lower means more flushes, higher means more redone.
# HUIVER_CHECKPOINT_CHUNKS=8

# How many times a chapter is attempted before it is marked failed (default 3).
# A retry continues from the last checkpoint on a fresh speech worker.
# HUIVER_TRACK_ATTEMPTS=3

# How long half-rendered audio is kept so a later run can continue from it, in days
# (default 14). Covers both a stopped or failed conversion and a chapter you only
# listened to part of. Set 0 to keep it forever.
# HUIVER_PARTIAL_TTL_DAYS=14

# ffmpeg binary: encodes finished MP3s, voice previews and the live playback stream.
# Without one, conversion still works and keeps WAVs. Set this for a build off PATH.
# HUIVER_FFMPEG=/opt/homebrew/bin/ffmpeg

# Restart the MPS worker after this many text chunks to contain a native Metal
# memory leak that empty_cache cannot release. Default 6; higher is faster but
# permits a larger footprint before the worker is replaced.
# HUIVER_MPS_RECYCLE_CHUNKS=6
