# ---------------------------------------------------------------------------
# huiver-specific
# ---------------------------------------------------------------------------

# Python venvs for the local TTS engines (~1 GB each). Chatterbox gets its own
# because it pins torch and transformers well below the versions Kokoro needs.
.venv
.venv-chatterbox
__pycache__
*.pyc

# Runtime state: uploaded books, generated audio, SQLite database
data

# Books and audio. Default is that nothing ships: a personal library is
# probably copyrighted and this is a public repo. Anything dropped into
# examples/ stays ignored unless it is named in the allowlist below.
examples/*
*.epub
*.mobi
*.azw3
*.m4b
*.mp3
*.wav

# ...except the curated Project Gutenberg corpus. Public domain, ~3 MB, and
# shipping it means the app is testable straight after a clone.
# Adding a sample? Add its filename here too, or it will silently not ship.
# Kept in sync with BOOKS in apps/web/scripts/fetch-examples.ts by a unit test.
!apps/web/examples/README.md
!apps/web/examples/alice-in-wonderland.epub
!apps/web/examples/dracula.epub
!apps/web/examples/frankenstein.epub
!apps/web/examples/metamorphosis.epub
!apps/web/examples/moby-dick.epub
!apps/web/examples/pride-and-prejudice.epub
!apps/web/examples/sherlock-holmes.epub
!apps/web/examples/the-time-machine.epub
!apps/web/examples/the-yellow-wallpaper.epub
!apps/web/examples/tom-sawyer.epub

.gstack/

# ---------------------------------------------------------------------------
# legacy/mobile (retired Expo app — see legacy/README.md. ios/ and android/ are
# generated by `expo prebuild` from app.config.ts and must not be hand-edited)
# ---------------------------------------------------------------------------
legacy/mobile/ios/
legacy/mobile/android/
legacy/mobile/.expo/
legacy/mobile/node_modules/

# ---------------------------------------------------------------------------
# ios (native Swift app — Chatterbox Nano on Core ML)
#
# Nothing model-shaped is committed. The .mlpackages come out of
# tools/export, the compiled .mlmodelc and the voice pack are derived from
# them, and together they are the better part of a gigabyte.
# ---------------------------------------------------------------------------
apps/ios/Models/
apps/ios/Voices/
apps/ios/build/
apps/ios/build-voices/
apps/ios/DerivedData/
apps/ios/Huiver.xcodeproj/xcuserdata/
apps/ios/Huiver.xcodeproj/project.xcworkspace/xcuserdata/

# ---------------------------------------------------------------------------
# mac (native Swift companion app — Chatterbox Multilingual on Core ML)
# ---------------------------------------------------------------------------
apps/mac/Models/
apps/mac/Voices/
apps/mac/build/
apps/mac/build-mtl/
apps/mac/DerivedData/
apps/mac/Huiver.xcodeproj/xcuserdata/
apps/mac/Huiver.xcodeproj/project.xcworkspace/xcuserdata/

# ---------------------------------------------------------------------------
# packages/huiverkit (the shared Swift package both apps compile)
# ---------------------------------------------------------------------------
packages/huiverkit/.build/
packages/huiverkit/.swiftpm/

# ---------------------------------------------------------------------------
# tools/export (Core ML export tooling)
# ---------------------------------------------------------------------------
tools/export/__pycache__/
