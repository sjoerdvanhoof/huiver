{
  "name": "@huiver/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "test": "bun test src",
    "e2e": "bun run scripts/e2e.ts",
    "e2e:resume": "bun run scripts/e2e-resume.ts",
    "examples": "bun run scripts/fetch-examples.ts && bun run scripts/import-examples.ts",
    "examples:import": "bun run scripts/import-examples.ts",
    "setup:python": "python3.11 -m venv .venv && .venv/bin/pip install -q --upgrade pip && .venv/bin/pip install -r py/requirements.txt"
  },
  "dependencies": {
    "@huiver/shared": "workspace:*",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest",
    "tailwindcss": "^4.1.11"
  }
}
