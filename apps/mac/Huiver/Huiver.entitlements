<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The server side of sync: the Mac listens, the phone connects. The
	     client side is for whatever the transport needs to dial back. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- EPUBs come in through the open panel or a drop, both of which grant
	     read access to exactly the file chosen. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Voice recording, once it arrives. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
