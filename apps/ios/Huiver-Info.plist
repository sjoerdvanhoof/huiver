<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Everything else is generated by Xcode from the INFOPLIST_KEY_* build
	  settings. This file exists for the keys that have no build setting.

	  `audio` is what lets synthesis carry on off screen while something is
	  playing; without it iOS suspends the app a few seconds after it leaves the
	  screen. `processing` pairs with the BGProcessingTask the converter submits,
	  which is how a book gets converted with nothing playing — on the system's
	  schedule rather than immediately, typically while charging and idle.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>processing</string>
	</array>
	<!-- Must match Converter.backgroundTaskIdentifier exactly, or the
	     registration throws at launch. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>online.mo4.huiver.nano.convert</string>
	</array>
	<!-- Sync. Browsing for a declared Bonjour type needs no multicast
	     entitlement; the local-network prompt appears on first use. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Huiver finds your Mac on the local network to sync books, audio and listening positions. Nothing leaves your network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_huiver._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>The camera is used only to scan the pairing code shown on your Mac.</string>
</dict>
</plist>
