<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Everything else is generated by Xcode from the INFOPLIST_KEY_* build
	  settings. This file exists for the one key that has no build setting:
	  background audio, without which iOS suspends the app a few seconds after
	  it leaves the screen and synthesis stops mid-chapter.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
